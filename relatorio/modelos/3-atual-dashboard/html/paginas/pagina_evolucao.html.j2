{#- Página de evolução mensal (só existe quando há pelo menos 2 meses de dados) + leitura do mês. -#}
{%- from "componentes/cabecalho.html.j2" import cabecalho with context -%}
{%- from "componentes/investimento.html.j2" import investimento with context -%}
{%- from "componentes/evolucao.html.j2" import evolucao -%}
{%- from "componentes/rodape.html.j2" import rodape with context -%}
{%- macro pagina_evolucao(n, total) -%}
<section class="pagina">
  {{ cabecalho() }}
  <main class="corpo">
    {{ investimento() }}
    {{ evolucao(relatorio.evolucao.cards, relatorio.evolucao.tem_parcial) }}
    {% if relatorio.observacoes %}
    <div>
      <h2>Leitura do mês</h2>
      <div class="card obs"><p>{{ relatorio.observacoes }}</p></div>
    </div>
    {% endif %}
  </main>
  {{ rodape(n, total) }}
</section>
{%- endmacro -%}
