{#- Página do topo (Instagram) e do fundo (WhatsApp): cabeçalho, investimento e os cards de cada seção. -#}
{%- from "componentes/cabecalho.html.j2" import cabecalho with context -%}
{%- from "componentes/investimento.html.j2" import investimento with context -%}
{%- from "componentes/banda.html.j2" import banda -%}
{%- from "componentes/kpi_card.html.j2" import kpi_card -%}
{%- from "componentes/caixa_leitura.html.j2" import caixa_leitura -%}
{%- from "componentes/rodape.html.j2" import rodape with context -%}
{%- macro pagina_instagram_whatsapp(secoes, n, total) -%}
<section class="pagina">
  {{ cabecalho() }}
  <main class="corpo">
    {{ investimento() }}
    {% for s in secoes %}
    <div class="bloco" style="--cor: var(--{{ s.etapa }}); --tint: var(--{{ s.etapa }}-tint)">
      {{ banda(s) }}
      <div class="kpis">{% for k in s.kpis %}{{ kpi_card(k) }}{% endfor %}</div>
      {{ caixa_leitura(s.comentario) }}
    </div>
    {% endfor %}
  </main>
  {{ rodape(n, total) }}
</section>
{%- endmacro -%}
