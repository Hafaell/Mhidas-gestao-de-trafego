{#- Cabeçalho azul-marinho, igual em todas as páginas: foto, logo da Meta, título e caixas de período. -#}
{%- macro cabecalho() -%}
{%- set cliente = relatorio.cliente -%}
<header class="cab">
  <div class="avatar">{% if cliente.foto %}<img src="{{ cliente.foto }}" alt="">{% else %}{{ cliente.iniciais }}{% endif %}</div>
  <div class="logo-meta"><svg viewBox="0 0 64 34" fill="none" stroke="#2b8cff" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 25C11 8 19 5 32 17s21 16 24 0c-2-15-12-18-24-6S11 38 8 25z"/></svg></div>
  <div class="cab-centro">
    <div class="l1">{{ cliente.nome }}</div>
    <div class="l2">Relatório de leads · Meta Ads</div>
    <div class="l3">{{ cliente.descricao }}{% if cliente.instagram %} · {{ cliente.instagram }}{% endif %}</div>
  </div>
  <div class="filtros">
    <div class="filtro"><small>Período</small><b>{{ relatorio.periodo_txt }}</b></div>
    {% if relatorio.anterior_txt %}<div class="filtro"><small>Comparado a</small><b>{{ relatorio.anterior_txt }}</b></div>{% endif %}
  </div>
</header>
{%- endmacro -%}
